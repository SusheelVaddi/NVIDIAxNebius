# Copy to .env and set values only when needed. Never commit real credentials.
# NEBIUS_API_KEY is shared by the planner and diagnosis client.
# Older shells may use NEMOTRON_API_KEY or NEBIUS_TOKEN_FACTORY_API_KEY.
NEBIUS_API_KEY=

# OpenAI-compatible Nebius API settings shared by planner and diagnosis.
# Base URL aliases: NEBIUS_BASE_URL, NEBIUS_TOKEN_FACTORY_BASE_URL
# Model aliases: NEBIUS_MODEL, NEMOTRON_MODEL
NEBIUS_API_BASE=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_TIMEOUT_SECONDS=30

# true selects local mock behavior for diagnosis and deterministic planner fallback.
# Mock mode never grants AI permission to execute a recovery action.
NEBIUS_MOCK_MODE=false

# Diagnosis is opt-in. The recovery planner may use Nemotron when a key is configured.
ENABLE_AI_DIAGNOSIS=false

# Optional: when set, POST /reset requires X-Admin-Reset-Token.
ADMIN_RESET_TOKEN=
